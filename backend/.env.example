# Copy to .env and fill real values. NEVER commit .env — it is gitignored.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=

# --- Auth ---
# REQUIRED in production. Startup fails if left as the placeholder.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS / WhatsApp (MSG91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- API hardening ---
# Comma-separated browser origins allowed to call this API. Never use "*".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated hostnames this API answers to. Empty = disabled (dev only).
ALLOWED_HOSTS=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=1048576

# --- Frontend (public, safe to expose to the browser) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
