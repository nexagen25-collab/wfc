# Copy to .env and fill real values. NEVER commit .env — it is gitignored.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=

# --- Auth ---
# REQUIRED in production. Startup fails if left as the placeholder.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS / WhatsApp (MSG91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- API hardening ---
# Comma-separated browser origins allowed to call this API. Never use "*".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated hostnames this API answers to. Empty = disabled (dev only).
ALLOWED_HOSTS=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BODY_BYTES=1048576

# --- Strict limits for the expensive routes ---
# A password check costs ~196 ms of CPU (measured), so /auth/ routes get their
# own much tighter budget. The buckets are separate from the general one: a
# customer browsing the menu cannot use up their own login allowance.
#
# These may only be set LOWER than the hard ceilings in app/rate_limit.py
# (login 5, otp/request 3, otp/verify 10 per 300s). A larger value here is
# clamped back down, and 0 or a negative value is treated as 1 - you cannot
# switch login throttling off from the environment.
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_OTP_REQUEST=3
RATE_LIMIT_OTP_VERIFY=10

# Ceiling on simultaneous password hashes in this process. Per-IP limits cannot
# stop an attacker who spreads requests across many addresses, so this caps
# total in-flight CPU work. Per-process; move to Redis when running more than
# one instance.
PASSWORD_HASH_CONCURRENCY=4

# --- Frontend (public, safe to expose to the browser) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
